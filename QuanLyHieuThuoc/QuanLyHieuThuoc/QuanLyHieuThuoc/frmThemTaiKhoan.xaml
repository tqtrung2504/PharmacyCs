<Window x:Class="QuanLyHieuThuoc.frmThemTaiKhoan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyHieuThuoc"
        mc:Ignorable="d"
        Title="Thêm tài khoản" Height="500" Width="360" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="Window_Loaded">
    <Grid>
        <StackPanel Margin="16">
            <Label FontWeight="Bold">Tên đăng nhập:</Label>
            <TextBox x:Name="txtTenDangNhap"
                materialDesign:HintAssist.Hint="Nhập tên đăng nhập"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <Label FontWeight="Bold">Tên hiển thị:</Label>
            <TextBox x:Name="txtTenHienThi"
                materialDesign:HintAssist.Hint="Nhập tên hiển thị"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <Label FontWeight="Bold">Số điện thoại:</Label>
            <TextBox x:Name="txtSoDienThoai"
                materialDesign:HintAssist.Hint="Nhập số điện thoại"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <Label FontWeight="Bold">Chi nhánh:</Label>
            <ComboBox x:Name="cbChiNhanh"/>

            <Label FontWeight="Bold">Mật khẩu:</Label>
            <PasswordBox x:Name="txtMatKhau"
                materialDesign:HintAssist.Hint="Nhập mật khẩu"
                Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />

            <Label FontWeight="Bold">Nhập lại mật khẩu:</Label>
            <PasswordBox x:Name="txtNhapLaiMatKhau"
                materialDesign:HintAssist.Hint="Nhập lại mật khẩu"
                Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />

            <Grid Margin="0,12,0,0" Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White"
                            Width="120" Click="XacNhanThem">
                        Thêm
                    </Button>
                </Grid>
                <Grid Grid.Column="1" HorizontalAlignment="Left" Margin="34,-1,0,1">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="120" Click="Huy" Margin="2,9,-2,6">
                        Hủy
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Window>

