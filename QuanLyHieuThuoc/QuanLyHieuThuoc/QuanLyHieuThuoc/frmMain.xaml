<Window x:Class="QuanLyHieuThuoc.frmMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyHieuThuoc"
        mc:Ignorable="d"
        Title="Quản lý cửa hàng bán thuốc" Height="560" Width="1200" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        WindowStyle="None"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Margin="0,-34,0,34">
            <!-- Áp dụng cho MỌI Button trong sidebar: hover đỏ, pressed đỏ đậm + nhún -->
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedDarkButton}">
                    <!-- mặc định -->
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                    <Setter Property="materialDesign:RippleAssist.IsCentered" Value="True"/>
                    <Setter Property="materialDesign:RippleAssist.Feedback" Value="#33FFFFFF"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Setter.Value>
                    </Setter>

                    <!-- hiệu ứng -->
                    <Style.Triggers>
                        <!-- Hover: nền đỏ -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Red"/>
                        </Trigger>

                        <!-- Pressed: đỏ đậm + nhún -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#D32F2F"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Disabled: mờ -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <StackPanel Margin="-4,37,4,-37">
                <!--Button Trang chủ -->
                <Button IsEnabled="True" x:Name="btnTrangChu" ToolTip="TRANG CHỦ" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnTrangChu_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Home" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="TRANG CHỦ" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!--Button nhập kho -->
                <Button IsEnabled="True" x:Name="btnNhapKho" ToolTip="NHẬP KHO" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnNhapKho_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="NHẬP KHO" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Button Bán hàng-->
                <Button IsEnabled="True" x:Name="btnBanHang" ToolTip="BÁN HÀNG" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnBanHang_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cart" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="BÁN HÀNG" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Button Thuốc-->
                <Button IsEnabled="True" x:Name="btnThuoc" ToolTip="THUỐC" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnThuoc_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pill" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="THUỐC" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Button Cửa hàng-->
                <Button IsEnabled="True" x:Name="btnCuaHang" ToolTip="CỬA HÀNG" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnCuaHang_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Store" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="CỬA HÀNG" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!--Button Báo cáo-->
                <Button IsEnabled="True" x:Name="btnBaoCao" ToolTip="BÁO CÁO" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnBaoCao_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Finance" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="BÁO CÁO" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!--Button Tài khoản-->
                <Button IsEnabled="True" x:Name="btnTaiKhoan" ToolTip="TÀI KHOẢN" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnTaiKhoan_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="TÀI KHOẢN" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!--Button Đăng xuất-->
                <Button IsEnabled="True" x:Name="btnThoat" ToolTip="ĐĂNG XUẤT" Foreground="White" Margin="5,0,0,5" HorizontalAlignment="Left" Height="65" Width="160" Click="BtnThoat_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LogoutVariant" Width="30" Height="30" HorizontalAlignment="Left"/>
                        <Label Content="ĐĂNG XUẤT" FontFamily="Segoe UI" FontSize="15" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ====== CÁC TAB NỘI DUNG GIỮ NGUYÊN ====== -->
        <Grid x:Name="tabTrangChu" Grid.Column="1" Visibility="Visible" Loaded="loadData">
            <Grid>
                <Grid.Background>
                    <ImageBrush ImageSource="/images/bgphamarcy.jpg" Stretch="UniformToFill"/>
                </Grid.Background>
                <Label x:Name="lbthoat"
                       Content="X"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Width="40" Height="60"
                       FontSize="36"
                       FontWeight="Bold"
                       MouseLeftButtonDown="lbThoat" Margin="0,-12,-12,0">
                    <Label.Style>
                        <Style TargetType="{x:Type Label}">
                            <Setter Property="Foreground" Value="black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
                <Border Background="White" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24" Padding="12">
                    <GroupBox Header="Thông tin tài khoản" Width="420">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Width="150">Tên đăng nhập:</Label>
                                <TextBlock x:Name="txtTenDangNhap" FontWeight="Bold" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Width="150">Tên hiển thị:</Label>
                                <TextBlock x:Name="txtTenHienThi" FontWeight="Bold" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Width="150">Số điện thoại:</Label>
                                <TextBlock x:Name="txtSoDienThoai" FontWeight="Bold" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Width="150">Chi nhánh làm việc:</Label>
                                <TextBlock x:Name="txtChiNhanh" FontWeight="Bold" IsEnabled="False">Full</TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Border>
            </Grid>
        </Grid>

        <!-- Nhập kho -->
        <Grid x:Name="tabNhapKho" Grid.Column="1" Visibility="Hidden">
            <GroupBox x:Name="GroupBoxNhapKho" Header="Nhập kho" Margin="18,32,18,28" Height="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="350"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ListView x:Name="lsvPhieuNhapKho">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Tên Thuốc" Width="250" DisplayMemberBinding="{Binding TenThuoc}"/>
                                    <GridViewColumn Header="Số lượng nhập" Width="150" DisplayMemberBinding="{Binding SoLuongNhap}"/>
                                    <GridViewColumn Header="Đơn vị" Width="100" DisplayMemberBinding="{Binding TenDonVi}"/>
                                    <GridViewColumn Header="Giá nhập" Width="120" DisplayMemberBinding="{Binding GiaNhap, StringFormat={}{0:N0}}"/>
                                    <GridViewColumn Header="Hạn sử dụng" Width="150" DisplayMemberBinding="{Binding HanSuDung, StringFormat=dd/MM/yyyy}"/>
                                    <GridViewColumn Header="Thành tiền" Width="150" DisplayMemberBinding="{Binding ThanhTien, StringFormat={}{0:N0}}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <Grid Grid.Row="1" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Label>Tổng tiền nhập:</Label>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="txtTongTienNhap" FontWeight="Bold" Foreground="Red" IsEnabled="False" VerticalAlignment="Center">0</TextBlock>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Label>vnd</Label>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Label HorizontalAlignment="Left">| Cửa hàng:</Label>
                                </Grid>
                                <Grid Grid.Column="1" HorizontalAlignment="Left">
                                    <TextBlock x:Name="txtCuaHangNhapKho" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False">NULL</TextBlock>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Label>Ngày làm việc:</Label>
                        </Grid>
                        <Grid Grid.Column="1">
                            <DatePicker x:Name="dtpNgayLamViecNhapKho" Width="150" HorizontalAlignment="Left" IsEnabled="False" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Thêm" Click="ThemNhapKho">Thêm</Button>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Xóa" Click ="XoaNhapKho">Xóa</Button>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignRaisedAccentButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="170" ToolTip="Nhập kho" materialDesign:RippleAssist.Feedback="#DD000000" Click="TaoHoaDonNhap">Tạo hóa đơn nhập</Button>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <Label x:Name="lbthoat_Copy"
                   Content="X"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Width="40" Height="60"
                   FontSize="36"
                   FontWeight="Bold"
                   MouseLeftButtonDown="lbThoat" Margin="0,-12,-12,0">
                <Label.Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </Grid>

        <!-- Bán hàng -->
        <Grid x:Name="tabBanHang" Grid.Column="1" Visibility="Hidden">
            <GroupBox x:Name="groupDonBanHang" Header="Bán hàng" Margin="18,32,18,28" Height="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="350"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ListView x:Name="lsvHoaDonBan">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Tên Thuốc" Width="250" DisplayMemberBinding="{Binding TenThuoc}"/>
                                    <GridViewColumn Header="Số lượng bán" Width="150" DisplayMemberBinding="{Binding SoLuongBan}"/>
                                    <GridViewColumn Header="Đơn vị" Width="100" DisplayMemberBinding="{Binding TenDonVi}"/>
                                    <GridViewColumn Header="Giá bán" Width="120" DisplayMemberBinding="{Binding GiaBan, StringFormat={}{0:N0}}"/>
                                    <GridViewColumn Header="Hạn sử dụng" Width="150" DisplayMemberBinding="{Binding HanSuDung}"/>
                                    <GridViewColumn Header="Thành tiền" Width="150" DisplayMemberBinding="{Binding ThanhTien, StringFormat={}{0:N0}}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <Grid Grid.Row="1" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Label>Tổng tiền thu:</Label>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="txtTongTienThu" FontWeight="Bold" Foreground="Red" IsEnabled="False" VerticalAlignment="Center">0</TextBlock>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Label>vnd</Label>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Label HorizontalAlignment="Left">| Cửa hàng:</Label>
                                </Grid>
                                <Grid Grid.Column="1" HorizontalAlignment="Left">
                                    <TextBlock x:Name="txtCuaHangLamViec" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False">NULL</TextBlock>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Label>Ngày làm việc:</Label>
                        </Grid>
                        <Grid Grid.Column="1">
                            <DatePicker x:Name="dtpNgayLamViecBanHang" Width="150" HorizontalAlignment="Left" IsEnabled="False"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Thêm" Click="ThemDonBanHang">Thêm</Button>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Xóa" Click ="XoaDonBanHang">Xóa</Button>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignRaisedAccentButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="170" ToolTip="Tạo hóa đơn bán" materialDesign:RippleAssist.Feedback="#DD000000" Click="TaoHoaDonBan">Tạo hóa đơn bán</Button>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <Label x:Name="lbthoat_Copy1"
                   Content="X"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Width="40" Height="60"
                   FontSize="36"
                   FontWeight="Bold"
                   MouseLeftButtonDown="lbThoat" Margin="0,-12,-12,0">
                <Label.Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </Grid>

        <!-- Thuốc -->
        <Grid x:Name="tabThuoc" Grid.Column="1" Visibility="Hidden">
            <TabControl Margin="0,6,0,0">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Danh sách thuốc"/>
                        </StackPanel>
                    </TabItem.Header>
                    <GroupBox Header="Danh sách thuốc" Margin="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="360"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <ListView x:Name="lsvThuoc">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding IdThuoc}"/>
                                            <GridViewColumn Header="Tên thuốc" DisplayMemberBinding="{Binding TenThuoc}" Width="200"/>
                                            <GridViewColumn Header="Hạn sử dụng" DisplayMemberBinding="{Binding HanSuDung, StringFormat=dd/MM/yyyy}" Width="150"/>
                                            <GridViewColumn Header="Kho" DisplayMemberBinding="{Binding SoLuong}" Width="100"/>
                                            <GridViewColumn Header="Đơn vị" DisplayMemberBinding="{Binding TenDonVi}" Width="100"/>
                                            <GridViewColumn Header="Giá nhập" DisplayMemberBinding="{Binding GiaNhap, StringFormat={}{0:N0}}" Width="100"/>
                                            <GridViewColumn Header="Giá bán" DisplayMemberBinding="{Binding GiaBan, StringFormat={}{0:N0}}" Width="100"/>
                                            <GridViewColumn Header="Ghi chú" DisplayMemberBinding="{Binding GhiChu}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                            <Grid Grid.Row="1" Width="400" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Thêm" Click="ThemThuoc">Thêm</Button>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Sửa" Click="SuaThuoc">Sửa</Button>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Xóa" Click="XoaThuoc">Xóa</Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Đơn vị"/>
                        </StackPanel>
                    </TabItem.Header>
                    <GroupBox Header="Danh sách đơn vị tính" Margin="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="360"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <ListView x:Name="lsvDonVi">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding IdDonvi}"/>
                                            <GridViewColumn Header="Tên đơn vị" Width="400" DisplayMemberBinding="{Binding TenDonVi}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                            <Grid Grid.Row="1" Width="400" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Thêm" Click="ThemDonVi">Thêm</Button>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Sửa" Click="SuaDonVi">Sửa</Button>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Xóa" Click="XoadonVi">Xóa</Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </TabItem>
            </TabControl>

            <Label x:Name="lbthoat_Copy2"
                   Content="X"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Width="40" Height="60"
                   FontSize="36"
                   FontWeight="Bold"
                   MouseLeftButtonDown="lbThoat" Margin="0,-12,-12,0">
                <Label.Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>

            <TextBox x:Name="txtSearchThuoc" TextChanged="txtSearchThuoc_TextChanged" materialDesign:HintAssist.Hint="Tìm theo tên thuốc" HorizontalAlignment="Left" Margin="776,51,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="236" Background="White"/>
        </Grid>

        <!-- Cửa hàng -->
        <Grid x:Name="tabCuaHang" Grid.Column="1" Visibility="Hidden">
            <GroupBox Header="Danh sách cửa hàng" Margin="16,29,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="400"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <ListView x:Name="lsvCuaHang">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding IdCuaHang}" Width="30"/>
                                    <GridViewColumn Header="Tên cửa hàng" Width="300" DisplayMemberBinding="{Binding TenCuaHang}"/>
                                    <GridViewColumn DisplayMemberBinding="{Binding DiaChi}" Header="Địa chỉ" Width="400"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1" Width="400" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Thêm" Click="ThemCuaHang">Thêm</Button>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Sửa" Click="SuaCuaHang">Sửa</Button>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="100" ToolTip="Xóa" Click="XoaCuaHang">Xóa</Button>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <Label x:Name="lbthoat_Copy3"
                   Content="X"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Width="40" Height="60"
                   FontSize="36"
                   FontWeight="Bold"
                   MouseLeftButtonDown="lbThoat" Margin="0,-12,-12,0">
                <Label.Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </Grid>

        <!-- Báo cáo -->
        <Grid x:Name="tabBaoCao" Grid.Column="1" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Báo cáo nhập kho -->
                <Grid Grid.Row="0">
                    <Border Background="{DynamicResource MaterialDesignBackground}">
                        <GroupBox Header="Báo cáo nhập kho" Style="{DynamicResource MaterialDesignGroupBox}" Margin="16,31,16,16" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Label>Ngày bắt đầu:</Label>
                                    </Grid>
                                    <Grid Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <DatePicker x:Name="dtpNgayBatDauBaoCaoNhapKho"
                                                    Width="150"
                                                    materialDesign:HintAssist.Hint="Ngày bắt đầu"
                                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Label>Ngày kết thúc:</Label>
                                    </Grid>
                                    <Grid Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <DatePicker x:Name="dtpNgayKetThucBaoCaoNhapKho"
                                                    Width="150"
                                                    materialDesign:HintAssist.Hint="Ngày kết thúc"
                                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="2" HorizontalAlignment="Right">
                                    <Button Click="BaoCaoNhapKho_Click"
                                            Style="{StaticResource MaterialDesignRaisedLightButton}"
                                            Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White"
                                            Width="100">
                                        Lọc
                                    </Button>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Border>
                </Grid>

                <!-- Báo cáo bán hàng -->
                <Grid Grid.Row="1">
                    <Border Background="{DynamicResource MaterialDesignBackground}">
                        <GroupBox Header="Báo cáo bán hàng" Style="{DynamicResource MaterialDesignGroupBox}" Margin="16" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Label>Ngày bắt đầu:</Label>
                                    </Grid>
                                    <Grid Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <DatePicker x:Name="dtpNgayBatDauBaoCaoBanHang"
                                                    Width="150"
                                                    materialDesign:HintAssist.Hint="Ngày bắt đầu"
                                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Label>Ngày kết thúc:</Label>
                                    </Grid>
                                    <Grid Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <DatePicker x:Name="dtpNgayKetThucBaoCaoBanHang"
                                                    Width="150"
                                                    materialDesign:HintAssist.Hint="Ngày kết thúc"
                                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="2" HorizontalAlignment="Right">
                                    <Button Click="BaoCaoBanHang_Click"
                                            Style="{StaticResource MaterialDesignRaisedLightButton}"
                                            Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White"
                                            Width="100">
                                        Lọc
                                    </Button>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="0,15,0,0">
                <GroupBox x:Name="groupboxBaoCao" Header="Báo cáo - Tổng: 0 vnđ" Style="{DynamicResource MaterialDesignGroupBox}" Margin="0,16,16,16" materialDesign:ColorZoneAssist.Mode="Accent" HorizontalAlignment="Right" Width="703">
                    <ListView x:Name="lsvBaoCao">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tên Thuốc" Width="120" DisplayMemberBinding="{Binding TenThuoc}"/>
                                <GridViewColumn Header="SL" Width="50" DisplayMemberBinding="{Binding SoLuong}"/>
                                <GridViewColumn Header="Đơn vị" Width="70" DisplayMemberBinding="{Binding TenDonVi}"/>
                                <GridViewColumn Header="Giá" Width="90" DisplayMemberBinding="{Binding Gia, StringFormat={}{0:N0}.000}"/>
                                <GridViewColumn Header="Hóa đơn" Width="75" DisplayMemberBinding="{Binding IdHoaDon}"/>
                                <GridViewColumn Header="Cửa hàng" Width="80" DisplayMemberBinding="{Binding IdCuaHang}"/>
                                <GridViewColumn Header="Ngày" Width="84" DisplayMemberBinding="{Binding Ngay, StringFormat=dd/MM/yyyy}"/>
                                <GridViewColumn Header="Thành tiền" Width="105" DisplayMemberBinding="{Binding ThanhTien, StringFormat={}{0:N0}.000}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
            </Grid>

            <Label x:Name="lbthoat_Copy4"
                   Content="X"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Width="40" Height="60"
                   FontSize="36"
                   FontWeight="Bold"
                   MouseLeftButtonDown="lbThoat" Margin="0,-12,-12,0" Grid.Column="1">
                <Label.Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>

            <TextBox x:Name="txtSearch" materialDesign:HintAssist.Hint="Tìm theo tên thuốc hoặc hoá đơn" Grid.Column="1" HorizontalAlignment="Left" Margin="480,35,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="236" Background="White" TextChanged="txtSearch_TextChanged"/>
        </Grid>

        <!-- Tài khoản -->
        <Grid x:Name="tabTaiKhoan" Grid.Column="1" Visibility="Hidden">
            <GroupBox Header="Quản lý tài khoản" Margin="16,29,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="360"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <ListView x:Name="lsvTaiKhoan">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Tên đăng nhập" Width="180" DisplayMemberBinding="{Binding TenDangNhap}"/>
                                    <GridViewColumn Header="Tên hiển thị" Width="180" DisplayMemberBinding="{Binding TenHienThi}"/>
                                    <GridViewColumn Header="Số điện thoại" Width="140" DisplayMemberBinding="{Binding SoDienThoai}"/>
                                    <GridViewColumn Header="Chi nhánh" Width="220" DisplayMemberBinding="{Binding TenCuaHang}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1" Width="620" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="120" Click="TaoTaiKhoan">Thêm</Button>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="120" Click="SuaTaiKhoanAdmin">Sửa</Button>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="120" Click="XoaTaiKhoan">Xóa</Button>
                        </Grid>
                        <Grid Grid.Column="3">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Width="120" Click="DoiMatKhau_Click">Đổi mật khẩu</Button>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <Label x:Name="lbthoat_Copy5"
                   Content="X"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Width="40" Height="60"
                   FontSize="36"
                   FontWeight="Bold"
                   MouseLeftButtonDown="lbThoat" Margin="0,-12,-12,0">
                <Label.Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </Grid>
    </Grid>
</Window>
